# ============================================================================
# Enterprise RAG backend —— 环境变量模板
# 复制为 backend/.env（或沿用项目根 .env），填入真实值。切勿提交含密钥的 .env。
# 变量名大小写不敏感，与 app/core/config.py 字段一一对应。
# ============================================================================

# ---- 应用 ----
APP_NAME=Enterprise RAG
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# ---- Qdrant 向量库 ----
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=personal_rag_v2

# ---- SiliconFlow（LLM + Embedding）----
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
VECTOR_DIM=1024
LLM_MODEL=deepseek-ai/DeepSeek-V3.2
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# ---- Chunk ----
DEFAULT_CHUNK_SIZE=512
DEFAULT_CHUNK_OVERLAP=50

# ---- 检索（dense + BM25 混合 + RRF）----
TOP_K=5
RETRIEVAL_MODE=hybrid
PREFETCH_K=20
HYBRID_TOKENIZE=true

# ---- Rerank 精排 ----
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATES=20

# ---- 低相关过滤（仅对 rerank 绝对分生效）----
SCORE_REL_RATIO=0.15
SCORE_ABS_MIN=0.05
SCORE_CONFIDENT=0.5
SCORE_MIN_KEEP=1
SCORE_DROP_ALL_BELOW=false

# ---- 鉴权与多租户（留空则关闭鉴权）----
# 格式: tenant_id=api_key;tenant_id2=api_key2
TENANT_FIELD=tenant_id
RAG_TENANT_KEYS=

# ---- Langfuse 可观测（两把密钥都填才启用）----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- 会话 ----
SESSION_TTL_SECONDS=3600
MAX_HISTORY_MESSAGES=20

# ---- PostgreSQL（P3 起启用）----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# ---- Redis（缓存 / 会话 / ARQ 队列，P3+P4 起启用）----
REDIS_URL=redis://localhost:6379/0
ARQ_QUEUE_NAME=rag_ingest

# ---- CORS（逗号分隔）----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
